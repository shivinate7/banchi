#!/usr/bin/env bash
# Provisions a NEW worktree the moment `git worktree add` makes it.
#
# The SessionStart hook (scripts/worktree-guard.sh) covers a session that STARTS in a
# worktree. It misses a worktree made mid-session, by hand or by a tool, because no
# session starts there. Git runs this hook after `git worktree add` (not with
# --no-checkout), with an all-zero previous HEAD, so this calls the same script for
# that case and no other. It also claims this tree's port slot, as SessionStart does.
# `make venv` runs in the foreground, so the add waits for pip once per worktree.
# A branch switch or a file checkout passes a real previous HEAD and runs nothing.
#
# Not a gate: post-checkout cannot stop a commit, so D18 (writers never gate) holds.
# Fails open: every exit is 0, so a setup bug never makes `git worktree add` look failed.

[ "${1:-}" = "0000000000000000000000000000000000000000" ] || exit 0
[ -f .git ] || exit 0
[ -f scripts/worktree-guard.sh ] || exit 0
bash scripts/worktree-guard.sh </dev/null || true
exit 0
