#!/usr/bin/env bash
# post-merge's sibling for the other way scripts/githooks/ moves under you: switching
# branches. Same reasoning lives there; this file states only what differs.
#
# Git calls this on every checkout, file or branch — $3 is 1 only for a branch move, which
# is the only case scripts/githooks/ can meaningfully differ across. A file-level checkout
# (`git checkout -- path`) passes 0 and is silent here, correctly: it cannot touch a
# tracked file outside the paths named on its own command line.
#
# Git passes $1 = previous HEAD, $2 = new HEAD, $3 = 1 for a branch checkout, 0 otherwise.
set -uo pipefail

old="${1:-}"; new="${2:-}"; branch_move="${3:-0}"
[ "$branch_move" = "1" ] || exit 0
[ -n "$old" ] && [ -n "$new" ] && [ "$old" != "$new" ] || exit 0

if git diff --name-only "$old" "$new" -- scripts/githooks 2>/dev/null | grep -q .; then
  echo "" >&2
  echo "scripts/githooks/ differs on this branch — the installed copy may now be stale." >&2
  echo "  Fix: make hooks" >&2
  echo "" >&2
fi

# ------------------------------------------------- the primary checkout left off main (D139)
# WHICH BRANCH THIS DIRECTORY STANDS ON DECIDES WHICH CODE SERVES THE OWNER'S REAL STORE.
#
# D53 keeps a supervisor alive at login out of the PRIMARY checkout, over the real
# `inventory/store.sqlite`. So a branch switch here is not a private act: the capture server
# on :8000 is rebuilt from whatever this directory now holds, and the owner goes on
# photographing cards into their real store through a branch's code. That is D43's hazard
# reached through the other door — D43 was the PORT pointing at the wrong store, this is the
# DIRECTORY pointing at the wrong code — and the repo guarded `refs/heads/main` with two hooks
# (D42) while guarding this not at all. Observed 2026-09-11: this tree sat on
# `claude/env-key-rotation` with three live sessions in it and nothing anywhere said so.
#
# A WARNING IS THE CEILING *HERE*, AND IT IS NO LONGER THE CEILING ANYWHERE —
# D158 is why.
# There is no `pre-checkout` hook: git calls this one AFTER the switch has happened, with the
# new HEAD already in place, so nothing in this file can refuse. Measured on this machine's git
# 2.39.3, `reference-transaction` cannot either — `git switch <branch>` moves HEAD as a SYMREF
# and fires no ref transaction at all, so a guard built there would have been silent through
# both observed incidents while firing on `checkout --detach`, which is neither of them.
#
# THE REFUSAL IS IN THE SERVER INSTEAD, because the harm is not the branch, it is D53's
# supervisor adopting this tree's code over the owner's real store. `scripts/serve.py:off_main`
# refuses the spawn, the reload, the re-exec and the build; this file, whose INSTALLED COPY a
# branch switch cannot rewrite, says so at the moment of the move and says the opposite where
# the branch just checked out has no such guard in it. D139's other two moments — `make status`
# and the SessionStart guard — still stand, because any one reader alone is missable.
#
# THE PRIMARY/LINKED TEST IS `server/ports.py:is_linked_worktree`'s, SPELLED ITS WAY: a linked
# worktree's `.git` is a FILE, a primary checkout's is a DIRECTORY. `app/devPort.ts`,
# `scripts/worktree-guard.sh` and `scripts/docs-audit.py` all detect on that same one fact and
# a second answer to one question is the thing this repo keeps refusing to add.
# `git rev-parse --git-dir` against `--git-common-dir` decides it too; it is the same fact with
# a subprocess in front of it. A worktree ON a branch is CORRECT and says nothing: the whole
# point of D43 is that a worktree has its own store and its own ports to be wrong on its own.
#
# Hooks run from the top of the working tree, and `--show-toplevel` is read rather than assumed
# so the test cannot be answered by whatever directory a caller happened to be standing in.
top="$(git rev-parse --show-toplevel 2>/dev/null)" || top=""
if [ -n "$top" ] && [ -d "$top/.git" ] && git rev-parse --verify --quiet main >/dev/null 2>&1; then
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
  # `--abbrev-ref` answers the literal string `HEAD` for a detached head, which is off main as
  # surely as a branch is and is named as what it is rather than printed as a branch called HEAD.
  if [ "$branch" = "HEAD" ]; then
    branch="a detached HEAD at $(git rev-parse --short HEAD 2>/dev/null || echo "$new")"
  fi
  if [ -n "$branch" ] && [ "$branch" != "main" ]; then
    echo "" >&2
    echo "PRIMARY CHECKOUT: now on $branch, not main." >&2
    echo "  This is the directory \`make launch-agent\` serves the owner's REAL store out of" >&2
    echo "  (D53, D139)." >&2
    echo "  Undo: git switch -   ·   on main again: git switch main" >&2

    # ------------------------- what the server will do about it
    # D158
    # D139 ASSERTED THE HARM AND CHECKED NOTHING: it said the live capture server "now runs
    # THIS branch's code" whether or not one was running at all. Since that entry the
    # supervisor
    # REFUSES to adopt a primary checkout that is off main, so the true sentence is different
    # and depends on two facts this hook can read cheaply.
    #
    # AND THIS IS THE HALF THAT SURVIVES THE SWITCH. `make hooks` COPIES this file into the
    # common `.git` dir, which `core.hooksPath` points every worktree of the clone at — so the
    # copy git runs is not rewritten by checking out a branch, while `scripts/serve.py` is.
    # That is the whole reason the second half lives here: the guard in the tree is absent from
    # exactly the checkout that just arrived, and this one cannot be.
    if [ -f "$top/.serve/supervisor.pid" ]; then
      # THE GUARD IS FOUND BY ITS ESCAPE HATCH'S NAME, which is the one token that cannot be in
      # this file for a second reason. A branch predating that entry does not carry it,
      # and neither
      # does one that deleted the guard. OVER-REPORTING IS THE SAFE DIRECTION for something
      # that only ever prints: renaming the hatch makes this say "stop it" where it need not,
      # never the reverse. `scripts/githooks-selftest.sh` asserts both directions against this
      # repo's own serve.py, so the token going stale is a failed commit rather than a silence.
      if grep -q 'primary_sync' "$top/scripts/serve.py" 2>/dev/null; then
        # THE THIRD STATE, AND IT IS NOW THE ORDINARY ONE
        # (D176). The sentence below this one — "it will REFUSE"
        # — was true and complete under D158 and is WRONG for a branch carrying the self-sync:
        # the supervisor does not refuse, it puts this tree back on main within a tick. A
        # person who has just typed `git switch` is standing right here, and being told the
        # opposite of what is about to happen to their tree is worse than being told nothing.
        #
        # FOUND BY THE MODULE'S NAME, the same trick and the same safe direction as the hatch
        # grep below: `primary_sync` cannot be in `serve.py` for a second reason, and
        # over-reporting only ever makes this say "it will sync" where it need not.
        echo "  A supervisor is live here and it will PUT THIS TREE BACK ON MAIN, within a" >&2
        echo "  tick, and then fast-forward main to origin/main. It refuses instead — naming" >&2
        echo "  what stopped it — if you have uncommitted tracked work here, a rebase or" >&2
        echo "  merge in progress, or a main that is not a fast-forward." >&2
        echo "  Work on a branch in a worktree, not here. To keep this tree where it is:" >&2
        echo "  PKMNSCAN_SYNC=off" >&2
      elif grep -q 'PKMNSCAN_SERVE_MAIN' "$top/scripts/serve.py" 2>/dev/null; then
        echo "  A supervisor is live here. It will REFUSE to reload into this branch —" >&2
        echo "  what is serving goes on serving, and comes back on \`git switch main\`." >&2
      else
        # KEPT ON ONE LINE ON PURPOSE. This is the sentence a person greps the scrollback for
        # and the one `scripts/githooks-selftest.sh` asserts; reflowed across a break it
        # matches neither, which is how the first draft of that case went red.
        echo "  A supervisor is live here and it WILL SERVE THIS BRANCH:" >&2
        echo "  this branch's scripts/serve.py predates the guard that refuses a checkout" >&2
        echo "  off main, so it will reload into this code over the owner's REAL store." >&2
        echo "  Stop it:  make down ARGS=--confirm" >&2
      fi
    fi
    # ON MAIN AND CURRENT ARE TWO QUESTIONS, and this hook can only answer the first. `main` here
    # is the LOCAL ref, which a clone that merges by pull request can leave well behind origin —
    # measured 2026-09-11 in this very checkout: local main at c34ccdc, origin/main at 2caa001,
    # six commits apart. So `git switch main` is the undo of the switch and not a claim that the
    # code is current, and saying otherwise would be wrong in exactly the situation a stale tree
    # is in. `make status` prints the counts that answer the second question.
    echo "  (local main can itself sit behind origin/main — \`make status\` says by how much)" >&2
    echo "" >&2
  fi
fi

exit 0
