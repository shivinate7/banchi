#!/usr/bin/env bash
# Pre-commit guard: three opsec rules, then the docs audit.
#
# The opsec half is the commit-time twin of scripts/guard-opsec.sh, which is a Claude Code
# PreToolUse hook: it reads a JSON payload and only ever sees writes the agent makes. This
# one reads the staged set, so it also covers edits you make in an editor. Same three
# rules, same reasons:
#
#   1. A live unredeemed code card is a bearer instrument. Anyone who reads the image or
#      the printed string owns the code. captures/ is gitignored; everywhere else is not.
#   2. Fixtures are ground truth for the round-trip test. If they drift, T2 still passes
#      and means nothing.
#
# The fourth rule, the docs audit, has no counterpart in guard-opsec.sh and lives only
# here. It needs the staged set to ask whether code and the docs describing it moved
# together, and a PreToolUse hook watching one write at a time cannot see that.
#
# Wired via `git config core.hooksPath scripts/githooks`, so it is tracked and reviewable
# rather than living unversioned in .git/hooks.
#
# Bypassing is `git commit --no-verify`, which is loud and on purpose.
#
# Note: guard-opsec.sh blocks writes containing a code-shaped literal, including in
# comments. That is why the printed-code layout is described below rather than spelled
# out, and why the pattern is assembled from parts.

set -uo pipefail

fail() {
  echo "COMMIT BLOCKED: $1" >&2
  exit 1
}

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged" ] && exit 0

# Fixtures: block changes to an existing one, allow a new one to be added. That is exactly
# the sanctioned path — a genuine schema change means a fresh export committed alongside
# the old, never an edit in place.
changed_fixtures="$(git diff --cached --name-only --diff-filter=MDR | grep -E '(^|/)fixtures/' || true)"
if [ -n "$changed_fixtures" ]; then
  fail "fixtures/ is ground truth for the round-trip test and is read-only.
  Changed: $(echo "$changed_fixtures" | tr '\n' ' ')
  If the schema genuinely changed, re-export from TCGplayer and commit that as a new fixture."
fi

# iCloud Drive conflict copies. This repo LEFT iCloud Drive on 2026-08-29 and the rule stays
# armed anyway (D44, amended): it costs one grep, and the hazard is a property of a synced
# DIRECTORY rather than of this project — a checkout made inside one on any machine brings it
# straight back. iCloud resolves a same-file race by writing a SECOND file beside the original
# with " 2"
# appended to the stem — `pre-push 2`, `githooks-selftest 2.sh`. They are untracked, so they
# are invisible until something says `git add -A`, which is exactly what an agent session
# says. Measured on 2026-08-29: three appeared in one afternoon, and one of them was
# installed as a git hook by `make hooks` before that target learned to enumerate through
# `git ls-files`.
#
# Refused rather than reported, because the failure is silent and permanent: a committed
# `foo 2.py` is a second copy of a module that no import reaches and no test runs, and it
# will be read later as a file somebody meant to write. Deleting it is always right; the
# original is the tracked one.
#
# The pattern is the stem ending in a space and digits, before an optional extension. A
# deliberate `Section 2.md` would trip it — the bypass below is the answer, and nothing in
# this repo is named that way today.
[ "${PKMNSCAN_DUPES:-}" = "off" ] && icloud_dupes="" || icloud_dupes="$(printf '%s\n' "$staged" | grep -E '(^|/)[^/]* [0-9]+(\.[A-Za-z0-9]+)?$' || true)"
if [ -n "$icloud_dupes" ]; then
  fail "iCloud Drive conflict copies staged:
$(printf '%s\n' "$icloud_dupes" | sed 's/^/    /')
  These are duplicates iCloud wrote beside the real file, not files anyone authored.
  Delete them — the tracked original is the one you want.
  If a name like this is genuinely intended:  PKMNSCAN_DUPES=off git commit ..."
fi

# A SYMLINK THAT LEAVES THE REPOSITORY. Refused, and it is the rule this hook was missing
# on 2026-08-29 when a tracked one cost the 133 MB image mirror (D47).
#
# THE SHAPE OF THE FAULT, because it is not obvious that a symlink is dangerous. A worktree
# provisions `app/node_modules` and `harness/images` as links into the MAIN working tree
# (scripts/worktree-guard.sh) — correct there, and an ABSOLUTE PATH. Committed, that path is
# baked into the tree; checked out in the main tree it points at ITSELF, and git will happily
# remove the ignored real directory to put it there. The data is gone with no message, and
# the loop is invisible until something opens it.
#
# GIT MODE 120000 IS THE TEST, so this cannot be fooled by a name: it asks the index what the
# staged object IS. An absolute target is refused outright; a relative one is refused when it
# climbs out of the repository, which is the same fault written differently.
#
# A relative link that stays inside the tree is allowed and is the only kind that survives a
# clone on another machine — which is the property this rule is really enforcing.
#
# Bypass:  PKMNSCAN_LINKS=off git commit ...
if [ "${PKMNSCAN_LINKS:-}" != "off" ]; then
  root="$(git rev-parse --show-toplevel)"
  while IFS= read -r link; do
    [ -z "$link" ] && continue
    target="$(git cat-file blob ":$link" 2>/dev/null || true)"
    case "$target" in
      /*)
        fail "symlink with an absolute target staged: $link -> $target
  Committed, that path is baked into the tree — and in the working tree it names, it
  points at itself. Checking it out replaces the real directory with a loop, silently.
  This is how the image mirror was lost (D47). Ignore the path instead of tracking it.
  If it is genuinely intended:  PKMNSCAN_LINKS=off git commit ..."
        ;;
      *)
        resolved="$(cd "$root/$(dirname "$link")" 2>/dev/null && cd "$(dirname "$target")" 2>/dev/null && pwd -P || true)"
        case "$resolved" in
          "$root"|"$root"/*|"") ;;
          *) fail "symlink pointing outside the repository staged: $link -> $target
  It resolves to $resolved, which no clone on another machine will have.
  If it is genuinely intended:  PKMNSCAN_LINKS=off git commit ..." ;;
        esac
        ;;
    esac
  done <<< "$(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n' | while IFS= read -r p; do [ -z "$p" ] && continue; mode="$(git ls-files --stage -- "$p" | awk '{print $1}')"; [ "$mode" = "120000" ] && printf '%s\n' "$p"; done)"
fi

while IFS= read -r path; do
  [ -z "$path" ] && continue

  case "$path" in
    captures/*|*/captures/*) continue ;;
    *.png|*.jpg|*.jpeg|*.webp|*.heic|*.PNG|*.JPG|*.JPEG)
      fail "image staged outside captures/ ($path).
  Code-card photos are bearer instruments and must never reach a tracked path."
      ;;
  esac
done <<< "$staged"

# Printed code layout: four hyphen-separated alphanumeric groups, of length 3, 4, 3, 3.
g3="[A-Z0-9]{3}"
g4="[A-Z0-9]{4}"
code_re="${g3}-${g4}-${g3}-${g3}"

if git diff --cached -U0 | grep -E '^\+' | grep -vE '^\+\+\+' | grep -Eq "$code_re"; then
  fail "staged content matches the printed code-card layout.
  Never commit a live code. Use a placeholder.
  Staged files: $(echo "$staged" | tr '\n' ' ')"
fi

# Fourth rule, and the only one here that is not about opsec: the docs audit (D16).
#
# scripts/docs-audit.py never writes. It opens, compares, prints, and sets an exit code,
# so the worst this block can do is stop a commit — it can never quietly rewrite a doc to
# make its own check pass.
#
#   1  a reference in the markdown is provably wrong  -> block
#   2  code changed and the doc describing it did not -> print the question, allow
#  64  this hook invoked the auditor wrongly           -> warn loudly, allow
#
# Exit 2 does not block on purpose. Stopping a commit over a question would make
# `--no-verify` habitual, and `--no-verify` also switches off the three opsec rules above.
# Trading a bearer-instrument guard for a prose reminder is a bad trade.
#
# 64 exists because the flags below are a second, independent statement of the auditor's
# interface. Argparse's default exit for an unrecognised flag is 2 — this hook's allow-and-
# print code — so a renamed option would have silently stopped the gate while printing what
# reads like the routine coupling question. The auditor now exits 64 there so it lands in
# the loud branch, and its `audit invocation` check reconciles these flags against argparse
# so it does not get that far.
#
# Anything else means the auditor itself is broken, which is not evidence the docs are
# wrong. Say so loudly and let the commit through.
#
# Bypass:  PKMNSCAN_DOCS=off git commit ...
#
# stdin is closed deliberately. Nothing in this block may prompt: `git commit` run from an
# agent session has no tty, and a hook that waits for input there hangs the session
# instead of failing it. See cli/__main__.py for the same rule stated for the pipeline.
if [ "${PKMNSCAN_DOCS:-}" != "off" ] && [ -f scripts/docs-audit.py ] && command -v python3 >/dev/null 2>&1; then
  audit_out="$(python3 scripts/docs-audit.py --staged </dev/null 2>&1)"
  audit_status=$?
  case "$audit_status" in
    0) ;;
    1)
      echo "$audit_out" >&2
      fail "the markdown disagrees with the code — see the findings above.
  Fix the reference, or the code it points at. Do not edit a doc purely to get
  past this hook (D16).
  Bypass once with:  PKMNSCAN_DOCS=off git commit ..."
      ;;
    2)
      echo "$audit_out"
      ;;
    64)
      echo "$audit_out" >&2
      echo "WARNING: this hook invoked scripts/docs-audit.py with a flag it does not accept," >&2
      echo "so THE DOCS AUDIT DID NOT RUN. Reconcile the invocation above with the parser." >&2
      echo "Allowing the commit: a broken caller is not evidence the docs are wrong." >&2
      ;;
    *)
      echo "WARNING: scripts/docs-audit.py exited $audit_status — the docs audit did not run." >&2
      echo "$audit_out" >&2
      echo "Allowing the commit: a broken auditor is not evidence the docs are wrong." >&2
      ;;
  esac
fi

# Fifth rule, and the second that is not about opsec: the sigil check (D92).
#
# A bare `#` on an owner-side screen is D58's COUNT of the cards in a box, and three
# renderers drew the STORE KEY with the same sigil — on the owner's box 3 those spaces are
# 76 apart, so `#27` named two different cards on one screen. scripts/sigil-check.py never
# writes, needs nothing but a system python3, and reads only tracked source, so it has the
# same profile as the docs audit above and belongs in the same place.
#
# IT BLOCKS, WHERE THE AUDIT'S COUPLING QUESTION DOES NOT, and the difference is that this
# has no "question" mode: a finding is a number on a screen that is wrong, not prose that
# might be stale. The escape hatch is per-line and demands a reason (`sigil-ok: <why>`),
# which is the right place to argue an exception — in the file, next to the code.
#
# WHOLE-TREE AND NOT `--staged`, deliberately. The check is fast enough (48 files) that
# scoping it would buy nothing, and a violation is a violation wherever it sits: staging
# only the fix to one screen should not let a second one through.
#
# THE SELF-TEST RUNS HERE TOO, WHICH `audit-self-test` DELIBERATELY DOES NOT, and the
# difference is the one D18 actually draws. That target is off the commit path because it
# WRITES — it builds a temporary directory of fixtures. This one writes nothing: sixteen
# cases over string literals, no filesystem, microseconds. D18 forbids a commit gate that
# writes, not one that checks itself, and a checker whose extractors have silently stopped
# matching is exactly the failure this repo has paid for most.
#
# A FAILING SELF-TEST WARNS AND ALLOWS, where a finding blocks. Same reasoning the docs
# audit applies to its own exit 64: a broken checker is not evidence that a screen is
# wrong, and blocking on one would make the bypass habitual.
#
# Bypass:  PKMNSCAN_SIGIL=off git commit ...
if [ "${PKMNSCAN_SIGIL:-}" != "off" ] && [ -f scripts/sigil-check.py ] && command -v python3 >/dev/null 2>&1; then
  if ! selftest_out="$(python3 scripts/sigil-check.py --self-test </dev/null 2>&1)"; then
    echo "$selftest_out" >&2
    echo "WARNING: scripts/sigil-check.py --self-test FAILED, so its extractors no longer" >&2
    echo "match the code they are meant to read. THE SIGIL CHECK BELOW MEANS NOTHING until" >&2
    echo "that is fixed. Allowing the commit: a broken checker is not evidence of a bug." >&2
  fi
  sigil_out="$(python3 scripts/sigil-check.py </dev/null 2>&1)"
  sigil_status=$?
  case "$sigil_status" in
    0) ;;
    1)
      echo "$sigil_out" >&2
      fail "a bare \`#\` is drawn over a store key — see the findings above.
  Draw the slot (D58's count); keep the index for addressing. If the key really is
  what belongs there, say so on the line or in the comment above it:
      sigil-ok: <why this record has no slot to draw instead>
  Bypass once with:  PKMNSCAN_SIGIL=off git commit ..."
      ;;
    *)
      echo "WARNING: scripts/sigil-check.py exited $sigil_status — the sigil check did not run." >&2
      echo "$sigil_out" >&2
      echo "Allowing the commit: a broken checker is not evidence a screen is wrong." >&2
      ;;
  esac
fi

exit 0
