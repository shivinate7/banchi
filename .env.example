# Copy to `.env` and fill in. `.env*` is gitignored (this example is the one exception).
#
# Write it as PLAIN TEXT. TextEdit defaults to Rich Text and will save `.env.rtf`, which
# buries the key in formatting codes under a filename nothing reads. In TextEdit:
# Format > Make Plain Text first, or just use `nano .env`.

# Anthropic — required by harness T1 and the batch script. https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# pokemontcg.io — optional. Free at https://dev.pokemontcg.io
# Keyless limits cover the 50-image harness; set-scale processing needs this
# (build-order step 11). Sent as X-Api-Key to api.pokemontcg.io only, never to the
# image CDN.
POKEMONTCG_API_KEY=

# TCGplayer seller portal — optional, and a BEARER INSTRUMENT. With it, `#/runs` fetches
# this run's Filtered Export itself instead of you downloading and uploading it (D64).
# Without it the fetch refuses `tcg_cookie_missing` and the upload path is unchanged.
#
# Sign in to store.tcgplayer.com, open any /admin/pricing request in the browser's network
# tab, and copy the WHOLE `Cookie:` header value — not just TCGAuthTicket_Production, because
# it is not established that the session hangs on that cookie alone. It expires; when it does
# the fetch says so by name and you replace this line.
#
# Sent over https to store.tcgplayer.com (the export, D64) and to
# order-management-api.tcgplayer.com (the order fetch, D69) — one .tcgplayer.com session, two
# hosts — and nowhere else. Never logged, never written into a run directory. This repo has no
# secret scanning — .env is the whole guard.
TCGPLAYER_STORE_COOKIE=

# The order fetch's second name, and it is NOT a secret: the lowercased prefix of every order
# number on your Orders page (the part before the first dash). Without it the order host answers
# 403 `order_seller_key_rejected`, which reads exactly like an expired session and is not one.
PKMNSCAN_TCG_SELLER_KEY=

# The WAF's remedy, if it ever declines this client: the User-Agent your browser sends.
# Measured 2026-08-30 unauthenticated, the stdlib default reaches the endpoint unblocked, so
# this is left unset until something says otherwise.
PKMNSCAN_TCG_USER_AGENT=
